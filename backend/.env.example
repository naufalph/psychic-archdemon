# =============================================================================
# RUMANTRA BACKEND ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and update the values for your environment
#
# INSTRUCTIONS:
# 1. cp .env.example .env
# 2. Update all values with your actual credentials
# 3. NEVER commit the .env file to git!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/rumantra-db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration (Generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration (comma-separated list of allowed origins)
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security Headers - HSTS (HTTP Strict Transport Security)
# ⚠️ WARNING: ONLY enable HSTS when HTTPS/SSL is properly configured!
# Once HSTS is enabled, browsers will REFUSE to connect via HTTP
# If you enable this without HTTPS, your site will become INACCESSIBLE!
#
# Development (no HTTPS): Set to false
# Production (with HTTPS): Set to true
HSTS_ENABLED=false
# Max age in seconds (31536000 = 1 year, recommended for production)
HSTS_MAX_AGE=31536000
# Include all subdomains (api.yourdomain.com, www.yourdomain.com, etc.)
HSTS_INCLUDE_SUBDOMAINS=true

# Google OAuth2 Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/rmtr/users/oauth2/callback/google

# LinkedIn OAuth2 Configuration
# Get these from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/rmtr/users/oauth2/callback/linkedin

# Email Configuration (Hostinger SMTP)
# Get these from your Hostinger control panel
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USERNAME=no-reply@yourdomain.com
EMAIL_PASSWORD=your_email_password

# Frontend Configuration
FRONTEND_URL=http://localhost:3000