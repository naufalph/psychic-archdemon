# Environment Configuration
NODE_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=rumantra
VITE_APP_VERSION=0.0.1
VITE_APP_DESCRIPTION=rumantra - To help architects showcase their work and connect with high-intent clients through a transparent, curated, and user-friendly platform

# Authentication Configuration
VITE_JWT_EXPIRY=86400
VITE_REMEMBER_ME_EXPIRY=2592000

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp
VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# External Services (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Analytics (Optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=your_hotjar_id_here

# Feature Flags
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# Development Configuration
VITE_DEBUG_MODE=true
VITE_API_TIMEOUT=30000
VITE_ENABLE_MOCK_DATA=false

# PWA Configuration (Optional)
VITE_PWA_ENABLED=false
VITE_PWA_NAME=rumantra
VITE_PWA_SHORT_NAME=rumantra
VITE_PWA_DESCRIPTION=To help architects showcase their work and connect with high-intent clients through a transparent, curated, and user-friendly platform
VITE_PWA_THEME_COLOR=#3b82f6
VITE_PWA_BACKGROUND_COLOR=#ffffff
